rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validAttachment(attachment) {
      return attachment == null || (
        attachment is map &&
        attachment.keys().hasOnly(['name', 'size', 'type', 'lastModified']) &&
        attachment.keys().hasAll(['name', 'size', 'type', 'lastModified']) &&
        attachment.name is string &&
        attachment.name.size() <= 255 &&
        attachment.size is int &&
        attachment.size >= 0 &&
        attachment.type is string &&
        attachment.type.size() <= 128 &&
        attachment.lastModified is int &&
        attachment.lastModified >= 0
      );
    }

    function validNotice() {
      return request.resource.data.keys().hasOnly([
          'number', 'category', 'title', 'content', 'createdAt', 'updatedAt',
          'views', 'isPinned', 'attachment'
        ]) &&
        request.resource.data.keys().hasAll([
          'number', 'category', 'title', 'content', 'createdAt', 'updatedAt',
          'views', 'isPinned', 'attachment'
        ]) &&
        request.resource.data.number is int &&
        request.resource.data.number > 0 &&
        request.resource.data.category in ['공지', '휴대폰', '오디오', '앱', '서비스', '정책'] &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 100 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 900000 &&
        request.resource.data.createdAt is string &&
        request.resource.data.updatedAt is string &&
        request.resource.data.views is int &&
        request.resource.data.views >= 0 &&
        request.resource.data.isPinned is bool &&
        validAttachment(request.resource.data.attachment);
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow create: if signedIn() && validNotice();
      allow update: if signedIn() &&
        validNotice() &&
        request.resource.data.number == resource.data.number &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.isPinned == resource.data.isPinned;
      allow delete: if signedIn();
    }

    match /noticeMetadata/{metadataId} {
      allow get: if signedIn() && metadataId == 'notice-counter';
      allow create: if signedIn() &&
        metadataId == 'notice-counter' &&
        request.resource.data.keys().hasOnly(['lastNumber']) &&
        request.resource.data.lastNumber is int &&
        request.resource.data.lastNumber >= 0;
      allow update: if signedIn() &&
        metadataId == 'notice-counter' &&
        request.resource.data.keys().hasOnly(['lastNumber']) &&
        request.resource.data.lastNumber is int &&
        request.resource.data.lastNumber >= resource.data.lastNumber;
    }
  }
}